# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site, no trailing slash. Used for canonical URLs, feeds, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string.
# Local: the docker-compose database (npm run db:up).
# Production: the pooled Neon connection string from the Vercel Marketplace integration.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/site

# Vercel Blob token for image uploads. Leave empty locally: uploads are then written to
# public/uploads/ (development only).
BLOB_READ_WRITE_TOKEN=

# Auth.js. Generate the secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# GitHub OAuth app (https://github.com/settings/developers).
# Callback URL: <site url>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Numeric GitHub user id of the only account allowed into /admin.
# Find it at https://api.github.com/users/<your-username> ("id").
ADMIN_GITHUB_ID=

# Development only: adds a one-click "Dev login" on /admin/login so the admin can be used
# without a GitHub OAuth app. Ignored unless NODE_ENV=development.
DEV_ADMIN_LOGIN=false
